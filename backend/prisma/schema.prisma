datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum AvailabilityStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum DocStatus {
  VERIFIED
  PENDING
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED_TO_WORKER
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED_REFUND
  RESOLVED_WORKER_PAID
}

model User {
  id                      String                 @id @default(uuid())
  email                   String                 @unique
  password                String
  name                    String
  phone                   String
  role                    UserRole               @default(CUSTOMER)
  city                    String                 @default("Bengaluru")
  state                   String                 @default("Karnataka")
  pincode                 String                 @default("560038")
  address                 String                 @default("Indiranagar, Bengaluru")
  walletBalance           Float                  @default(2500.0)
  idProofType             String?                // "Aadhaar", "PAN", "Voter ID", "Passport", "Driving License"
  idProofUrl              String?
  idProofStatus           DocStatus              @default(VERIFIED)
  addressProofType        String?                // "Electricity Bill", "Rent Agreement", "Water Bill"
  addressProofUrl         String?
  addressProofStatus      DocStatus              @default(VERIFIED)
  rejectionReason         String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  worker                  Worker?
  bookings                Booking[]              @relation("CustomerBookings")
  reviews                 Review[]               @relation("CustomerReviews")
  complaints              Complaint[]            @relation("CustomerComplaints")
  notifications           Notification[]
  jobRequests             JobRequest[]           @relation("CustomerJobRequests")
}


model Worker {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession            String
  categorySlug          String
  avatarUrl             String
  phoneNumber           String
  experienceYears       Int                 @default(5)
  city                  String              @default("Bengaluru")
  neighborhood          String              @default("Indiranagar")
  distanceKm            Float               @default(2.0)
  availability          AvailabilityStatus  @default(ONLINE)
  hourlyRate            Float               @default(350.0)
  startingPrice         Float               @default(199.0)
  about                 String
  spokenLanguages       String              @default("[\"English\",\"Hindi\",\"Kannada\"]") // JSON string
  serviceRadiusKm       Int                 @default(12)
  toolsEquipped         String              @default("[]") // JSON string
  pastWorkPhotos        String              @default("[]") // JSON string
  specialties           String              @default("[]") // JSON string
  badges                String              @default("[]") // JSON string

  // Trust Metrics
  overallScore          Int                 @default(90)
  ratingAverage         Float               @default(4.8)
  totalReviews          Int                 @default(10)
  completedJobsCount    Int                 @default(25)
  onTimeArrivalRate     Float               @default(98.0)
  cancellationRate      Float               @default(1.0)
  repeatCustomerRate    Float               @default(40.0)
  zeroComplaintStreakDays Int               @default(100)
  averageResponseMinutes Int                @default(5)
  skillCertificationLevel String            @default("Certified Professional")

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  verification          WorkerVerification?
  services              WorkerService[]
  bookings              Booking[]           @relation("WorkerBookings")
  reviews               Review[]            @relation("WorkerReviews")
  complaints            Complaint[]         @relation("WorkerComplaints")
}

model Service {
  id                 String          @id @default(uuid())
  name               String
  slug               String          @unique
  iconName           String          @default("Wrench")
  description        String
  startingPrice      Float           @default(199.0)
  activeWorkersCount Int             @default(20)
  averageRating      Float           @default(4.85)
  tags               String          @default("[]") // JSON string
  rateCards          String          @default("[]") // JSON string of rate card items
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workerServices     WorkerService[]
  bookings           Booking[]
}

model WorkerService {
  id         String   @id @default(uuid())
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workerId, serviceId])
}

model WorkerVerification {
  id                     String    @id @default(uuid())
  workerId               String    @unique
  worker                 Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  aadhaarNumberMasked    String    @default("XXXX-XXXX-1234")
  aadhaarStatus          DocStatus @default(VERIFIED)
  tradeCertificateName   String    @default("National Trade Certificate")
  tradeCertificateIssuer String    @default("DGT Trade Council")
  tradeCertificateStatus DocStatus @default(VERIFIED)
  policeClearanceNumber  String    @default("KA-BLR-CR-001")
  policeClearanceDate    String    @default("2025-10-01")
  policeClearanceStatus  DocStatus @default(VERIFIED)
  insurancePolicyNumber  String    @default("HDFC-WRK-991")
  insuranceCoverageAmount String   @default("₹5,00,000 Safety Cover")
  insuranceStatus        String    @default("active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Booking {
  id                 String                 @id @default(uuid())
  serviceId          String
  service            Service                @relation(fields: [serviceId], references: [id])
  serviceName        String
  serviceItemName    String
  categorySlug       String
  workerId           String
  worker             Worker                 @relation("WorkerBookings", fields: [workerId], references: [id])
  customerId         String
  customer           User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  customerName       String
  customerPhone      String
  status             BookingStatus          @default(REQUESTED)
  scheduledDate      String
  scheduledTimeSlot  String
  problemDescription String
  problemPhotoUrl    String?
  address            String                 // JSON string of Address
  baseAmount         Float
  civicGuaranteeFee  Float                  @default(29.0)
  taxes              Float
  totalAmount        Float
  paymentStatus      PaymentStatus          @default(HELD_IN_ESCROW)
  startOtp           String
  completionOtp      String
  reviewSubmitted    Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  timeline           BookingStatusHistory[]
  reviews            Review[]
  complaints         Complaint[]
}

model BookingStatusHistory {
  id         String        @id @default(uuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status     BookingStatus
  note       String
  timestamp  String
  createdAt  DateTime      @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  workerId           String
  worker             Worker   @relation("WorkerReviews", fields: [workerId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User     @relation("CustomerReviews", fields: [customerId], references: [id])
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id])
  customerName       String
  customerCity       String   @default("Bengaluru")
  rating             Int      @default(5)
  serviceRendered    String
  comment            String
  verifiedBooking    Boolean  @default(true)
  workPhotoUrl       String?
  aiSentiment        String?  // Positive, Neutral, Negative
  aiSuspiciousFlag   Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Complaint {
  id                 String        @id @default(uuid())
  bookingId          String
  booking            Booking       @relation(fields: [bookingId], references: [id])
  customerId         String
  customer           User          @relation("CustomerComplaints", fields: [customerId], references: [id])
  workerId           String
  worker             Worker        @relation("WorkerComplaints", fields: [workerId], references: [id])
  customerName       String
  workerName         String
  serviceName        String
  amount             Float
  reason             String
  status             DisputeStatus @default(UNDER_INVESTIGATION)
  priority           String        @default("medium")
  resolution         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   @default("info")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model JobRequest {
  id             String    @id @default(uuid())
  customerId     String
  customer       User      @relation("CustomerJobRequests", fields: [customerId], references: [id], onDelete: Cascade)
  categorySlug   String
  title          String
  description    String
  address        String
  city           String    @default("Bengaluru")
  budgetMin      Float
  budgetMax      Float
  urgency        String    @default("immediate") // "immediate", "today", "flexible"
  status         String    @default("open")      // "open", "assigned", "completed"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bids           JobBid[]
}

model JobBid {
  id                      String     @id @default(uuid())
  jobRequestId            String
  jobRequest              JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  workerId                String
  workerName              String
  workerAvatar            String
  workerProfession        String
  trustScore              Int        @default(95)
  quotedPrice             Float
  estimatedArrivalMinutes Int        @default(20)
  message                 String
  status                  String     @default("pending") // "pending", "accepted", "rejected"
  createdAt               DateTime   @default(now())
}

